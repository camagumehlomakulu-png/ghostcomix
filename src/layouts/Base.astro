---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'GHOSTCOMIX', description = 'A home for original comics.' } = Astro.props;
const pageTitle = title === 'GHOSTCOMIX' ? title : `${title} · GHOSTCOMIX`;
---

<!doctype html>
<html lang="en" data-theme="ghost">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved) document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">GHOSTCOMIX</a>
      <nav aria-label="Main">
        <a href="/comics/">Comics</a>
        <a href="/about/">About</a>
        <button id="theme-toggle" class="btn btn-quiet" type="button">Rose theme</button>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">© GHOSTCOMIX</footer>

    <script is:inline>
      const root = document.documentElement;
      const button = document.getElementById('theme-toggle');
      const setLabel = () => {
        button.textContent = root.dataset.theme === 'rose' ? 'Ghost theme' : 'Rose theme';
      };
      setLabel();
      button.addEventListener('click', () => {
        const next = root.dataset.theme === 'rose' ? 'ghost' : 'rose';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        setLabel();
      });
    </script>
  </body>
</html>